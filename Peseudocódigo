ALGORITMO GiraRota
INÍCIO
    // 1. Definição de Parâmetros e Locais
    ORIGEM_BLOQUEIO ← "Praça Central"
    DESTINO_BLOQUEIO ← "Rua do Sol"
    PONTO_ORIGEM ← "Residência"
    PONTO_DESTINO ← "Universidade"

    // 2. Inicialização do Grafo
    Criar Grafo Vazio (G)

    // 3. Adição das Arestas e Pesos (Custo Composto)
    AdicionarAresta(G, 'Residência', 'Praça Central', peso = 4)
    AdicionarAresta(G, 'Residência', 'Av. das Flores', peso = 2)
    AdicionarAresta(G, 'Praça Central', 'Av. das Flores', peso = 1)
    AdicionarAresta(G, 'Praça Central', 'Rua do Sol', peso = 5) // Via que pode ser bloqueada
    AdicionarAresta(G, 'Av. das Flores', 'Rua do Sol', peso = 3)
    AdicionarAresta(G, 'Praça Central', 'Universidade', peso = 15)
    AdicionarAresta(G, 'Rua do Sol', 'Rua do Comércio', peso = 2)
    AdicionarAresta(G, 'Av. das Flores', 'Rua do Comércio', peso = 6)
    AdicionarAresta(G, 'Rua do Comércio', 'Universidade', peso = 3)

    // 4. Aplicação da Regra de Segurança (Bloqueio de Via)
    SE ExisteAresta(G, ORIGEM_BLOQUEIO, DESTINO_BLOQUEIO) ENTÃO
        DefinirPesoAresta(G, ORIGEM_BLOQUEIO, DESTINO_BLOQUEIO, INFINITO)
        DefinirPesoAresta(G, DESTINO_BLOQUEIO, ORIGEM_BLOQUEIO, INFINITO) // Via bidirecional
    FIM_SE

    // 5. Cálculo da Rota Segura com o Algoritmo de Dijkstra
    melhor_rota ← ExecutarDijkstraCaminho(G, origem = PONTO_ORIGEM, destino = PONTO_DESTINO)
    custo_total ← ExecutarDijkstraCusto(G, origem = PONTO_ORIGEM, destino = PONTO_DESTINO)

    // 6. Exibição dos Resultados Textuais
    Imprimir("=== GIRAROTA - ROTA SEGURA ===")
    Imprimir("Partida: ", PONTO_ORIGEM, " | Destino: ", PONTO_DESTINO)
    Imprimir("Melhor Rota: ", melhor_rota)
    Imprimir("Custo Total: ", custo_total)

    // 7. Visualização Gráfica (Resumo da Interface)
    ConfigurarJanelaGrafica(cor_fundo = "Rosa Suave")
    DesenharMapaComRotasDestacadas(G, melhor_rota, arestas_bloqueadas)
    MostrarTela()
FIM
